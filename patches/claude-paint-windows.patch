diff --git a/crates/easel/src/uds.rs b/crates/easel/src/uds.rs
new file mode 100644
index 0000000..07e8fc6
--- /dev/null
+++ b/crates/easel/src/uds.rs
@@ -0,0 +1,43 @@
+//! The session's socket. On Unix, std's Unix-domain sockets. Elsewhere (Windows)
+//! there is no live session server: these stand-ins compile and fail with a reason,
+//! so `easel run` and the other one-shot commands build and work there.
+#[cfg(unix)]
+pub use std::os::unix::net::{UnixListener, UnixStream};
+#[cfg(not(unix))]
+pub use stub::{UnixListener, UnixStream};
+
+#[cfg(not(unix))]
+mod stub {
+    use std::io;
+    use std::path::Path;
+    use std::time::Duration;
+
+    fn unsupported<T>() -> io::Result<T> {
+        Err(io::Error::new(io::ErrorKind::Unsupported,
+            "live easel sessions need Unix sockets (macOS, Linux); here only one-shot commands such as `easel run` work"))
+    }
+
+    pub struct UnixStream(());
+    impl UnixStream {
+        pub fn connect<P: AsRef<Path>>(_: P) -> io::Result<Self> { unsupported() }
+        pub fn try_clone(&self) -> io::Result<Self> { unsupported() }
+        pub fn set_nonblocking(&self, _: bool) -> io::Result<()> { unsupported() }
+        pub fn set_read_timeout(&self, _: Option<Duration>) -> io::Result<()> { unsupported() }
+        pub fn set_write_timeout(&self, _: Option<Duration>) -> io::Result<()> { unsupported() }
+    }
+    impl io::Read for UnixStream {
+        fn read(&mut self, _: &mut [u8]) -> io::Result<usize> { unsupported() }
+    }
+    impl io::Write for UnixStream {
+        fn write(&mut self, _: &[u8]) -> io::Result<usize> { unsupported() }
+        fn flush(&mut self) -> io::Result<()> { unsupported() }
+    }
+
+    pub struct UnixListener(());
+    impl UnixListener {
+        pub fn bind<P: AsRef<Path>>(_: P) -> io::Result<Self> { unsupported() }
+        pub fn accept(&self) -> io::Result<(UnixStream, ())> { unsupported() }
+        pub fn incoming(&self) -> std::iter::Empty<io::Result<UnixStream>> { std::iter::empty() }
+        pub fn set_nonblocking(&self, _: bool) -> io::Result<()> { unsupported() }
+    }
+}
