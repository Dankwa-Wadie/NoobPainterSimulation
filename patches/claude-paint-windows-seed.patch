diff --git a/.cargo/config.toml b/.cargo/config.toml
index d81924a..f3604ef 100644
--- a/.cargo/config.toml
+++ b/.cargo/config.toml
@@ -4,3 +4,9 @@
 # builds Lua with a fixed seed. Only lua-src compiles C in this workspace.
 # (Session::new checks it and refuses to run without it.)
 CFLAGS = "-Dluai_makeseed()=0x5eedu"
+# MSVC's cl can't define a function-like macro from the command line, so on
+# Windows the seed is an object-like macro that still reads as a call:
+# `luai_makeseed()` becomes `0x5eedu+0*rand()`, the same seed. A target's own
+# CFLAGS_<target> replaces CFLAGS in the cc crate, so this touches nothing else.
+CFLAGS_x86_64_pc_windows_msvc = "-Dluai_makeseed=0x5eedu+0*rand"
+CFLAGS_aarch64_pc_windows_msvc = "-Dluai_makeseed=0x5eedu+0*rand"
